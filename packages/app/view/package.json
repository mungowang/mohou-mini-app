{
  "name": "@mohou/app-view",
  "version": "1.0.24",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "lib/types",
    "README.md",
    "!**/*.tsbuildinfo"
  ],
  "main": "./src/index.ts",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./src/index.ts"
    },
    "./css": {
      "types": "./src/app-card-css.ts",
      "default": "./src/app-card-css.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@mohou/contract": "workspace:^",
    "@mohou/values": "workspace:^",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
