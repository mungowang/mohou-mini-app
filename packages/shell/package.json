{
  "name": "@mohou/shell",
  "version": "1.0.27",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "dist",
    "skill",
    "lib/types",
    "README.md",
    "!**/*.tsbuildinfo"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@mohou/host": "workspace:^",
    "@mohou/panel": "workspace:^",
    "@mohou/runtime-pi": "workspace:^",
    "@mohou/runtime-provider": "workspace:^",
    "esbuild": "^0.28.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
