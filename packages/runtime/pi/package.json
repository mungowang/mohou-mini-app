{
  "name": "@mohou/runtime-pi",
  "version": "1.0.20",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "lib/types",
    "README.md",
    "!**/*.tsbuildinfo"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@mohou/contract": "workspace:^",
    "@mohou/runtime-provider": "workspace:^"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.85.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1"
  }
}
